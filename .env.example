# Optional repo-root env (loaded by tools/wefunder/*.py before server/.env).
# server/.env overrides duplicate keys — keep Mongo + Apify there if you prefer.

# --- Vertex + Gemini (same as vertex_google_search_demo.py) ---
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Service account (optional; else use gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
