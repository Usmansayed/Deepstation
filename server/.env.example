# Copy to .env and adjust.

MONGODB_URI=mongodb://127.0.0.1:27017/deepstation
PORT=4000

# Apify (used by tools/wefunder/fetch_raw.py). Any one of these names works:
APIFY_KEY=
# apify_key=

# Optional Wefunder raw scrape tuning (see tools/wefunder/README.md)
# WEFUNDER_LIMIT=200
# WEFUNDER_SEARCH=
# WEFUNDER_CATEGORY=

# AI research chat (POST /api/ai-research/chat) — same auth as vertex_google_search_demo.py:
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT_ID
#   gcloud services enable aiplatform.googleapis.com
# GOOGLE_CLOUD_PROJECT=   # optional if gcloud default project is set
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_GEMINI_MODEL=gemini-2.5-flash
# Fallback (no ADC): Gemini Developer API key
# GEMINI_API_KEY=

# Vertex / Gemini — same variables as repo-root vertex_google_search_demo.py
# (you can put these in repo-root .env instead; see ../.env.example)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_GEMINI_MODEL=gemini-2.5-flash
# Legacy alias still read by vertex_batch_structure.py:
# GEMINI_VERTEX_MODEL=gemini-2.5-pro
