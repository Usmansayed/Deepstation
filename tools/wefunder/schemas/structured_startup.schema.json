{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepstation.local/schemas/structured_startup.json",
  "title": "PublicStartupRecord",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "slug",
    "name",
    "tagline",
    "description",
    "logo",
    "sector",
    "stage",
    "location",
    "founded",
    "raising",
    "valuation",
    "raised",
    "credibility",
    "momentum",
    "followers",
    "founders",
    "updates",
    "traction",
    "highlights"
  ],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "logo": { "type": "string" },
    "sector": { "type": "string" },
    "stage": { "type": "string", "enum": ["Pre-seed", "Seed", "Series A", "Series B"] },
    "location": { "type": "string" },
    "founded": { "type": "string" },
    "raising": { "type": "number", "minimum": 0 },
    "valuation": { "type": "number", "minimum": 0 },
    "raised": { "type": "number", "minimum": 0 },
    "credibility": { "type": "number", "minimum": 0, "maximum": 100 },
    "momentum": { "type": "number", "minimum": 0, "maximum": 100 },
    "followers": { "type": "number", "minimum": 0 },
    "founders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "bio", "verified"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "bio": { "type": "string" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "type", "title", "body"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["milestone", "product", "traction", "team", "fundraise"]
          },
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "traction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["month", "revenue", "users"],
        "properties": {
          "month": { "type": "string" },
          "revenue": { "type": "number" },
          "users": { "type": "number" }
        }
      }
    },
    "highlights": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
